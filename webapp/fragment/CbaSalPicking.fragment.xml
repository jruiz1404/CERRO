<core:FragmentDefinition 
    xmlns="sap.m" 
	xmlns.t="sap.ui.table"
    xmlns:l="sap.ui.layout" 
    xmlns:f="sap.ui.layout.form" 
    xmlns:core="sap.ui.core">

    <Dialog id="idPickingDialog" >

        <Table id="idTableListPicking" 
            items="{/SalidasIngSet}"
			width="auto"
			mode="SingleSelectMaster"
			selectionChange="onPickSelect">
			<columns>
				<Column id="idPickingCol1">
					<Text id="idPickingColText1" text="{i18n>labelPos}" textAlign="Center"/>
				</Column>
                <Column id="idPickingCol2">
					<Text id="idPickingColText2" text="{i18n>labelPallet}" textAlign="Center"/>
				</Column>
                <Column id="idPickingCol3">
					<Text id="idPickingColText3" text="{i18n>labelMaterial}" textAlign="Center"/>
				</Column>
				<Column id="idPickingCol4">
					<Text id="idPickingColText4" text="{i18n>labelCantidad}" textAlign="Center"/>
				</Column>
			</columns>
			<items>
				<ColumnListItem id="idPickingColumnList1">
					<cells>
						<Label id="idPickingPos" text="{Posicion}" />
						<Label id="idPickingPallet" text="{Pallet}" />
						<ObjectIdentifier id="idPickingOject" title="{Material}" text="{Descripcion}"/>
						<Label id="idPickingCantidad" text="{Quantity}" />
					</cells>
				</ColumnListItem>
			</items>
		</Table> 

        <buttons>
			<Button id="idBtnCerrar" text="{i18n>action.cerrar}" icon="sap-icon://decline" press="onPickCerrar" type="Reject"/>
		</buttons>
    </Dialog>
</core:FragmentDefinition>