<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:l="sap.ui.layout" 
    xmlns:f="sap.ui.layout.form" 
    xmlns:core="sap.ui.core">
    <Dialog id="idControlDialog">

        <Table id="idTableListControl" 
            items="{/SalidasControlSet}"
			width="auto"
			mode="None">
            <columns>
				<Column id="_IDGenColumn4">
					<Text id="_IDGenText6" text="{i18n>Detalle}" textAlign="Center"/>
				</Column>
			</columns>
			<items>
				<ColumnListItem id="_IDGenColumnListItem1">
					<cells>
						<Label id="_IDGenLabel1" text="{Detalle}"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
        <buttons>
			<Button id="idBtnConfirmar" text="{i18n>action.confirmar}" press="onCtrlfirmSal" enabled="true" visible="false" type="Accept" />
			<Button id="idBtnPickCerrar" text="{i18n>action.cerrar}" icon="sap-icon://decline" press="onCtrlCerrar" type="Reject"/>
		</buttons>
    </Dialog>
</core:FragmentDefinition>