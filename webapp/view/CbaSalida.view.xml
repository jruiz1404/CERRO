<mvc:View controllerName="cerro.dsi.controller.CbaSalida"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:ndc="sap.ndc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:html="http://www.w3.org/1999/xhtm">
    <Page id="CbaSalida" title="{i18n>Cordoba} - {i18n>Salida} - {i18n>Posiciones}" titleAlignment="Center" showNavButton="true" navButtonPress="onNavBack" >

        <FlexBox id="flexCbaSal" height="100px" alignItems="Start" justifyContent="Center">
		    <VBox id="Vbox02Sal" alignContent="Center" alignItems = "Center" >

                <HBox id="Hbox01Sal">

                    <Input id="InpCbaSal" submit="onCbaSalida" maxLength="30" width="300px" value="{/scannedValue}"/>
                    <!-- <Button id="btnCEntBarra" press="onScan" icon="sap-icon://bar-code" />  -->

                    <ndc:BarcodeScannerButton
			            id="sampleBarcodeScannerButtonSal"
			            scanSuccess="onScanSuccess"
			            scanFail="onScanError"
			            inputLiveUpdate="onScanLiveupdate"
			            dialogTitle="Barcode Scanner"
		            />

                </HBox>
            	<Button id="btnCSal1" text="{i18n>action.Continuar}" press="onCbaSalida" class="bigButton"/> 
            

            </VBox>
        </FlexBox>

    </Page>
    
</mvc:View>