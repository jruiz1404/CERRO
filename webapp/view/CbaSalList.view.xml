<mvc:View controllerName="cerro.dsi.controller.CbaSalList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:ndc="sap.ndc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:html="http://www.w3.org/1999/xhtm">
    <Page id="CbaSalList" title="{i18n>Cordoba} - {i18n>Salida} - {i18n>Seleccione} " 
        titleAlignment="Center" showNavButton="true" navButtonPress="onNavBack" >
 
		<Table id="idTableSal" 
			items="{/SalidasPosSet}" 
			mode="SingleSelectMaster" 
			itemPress="onPressItem"
			selectionChange="onPressItem"   >
		<headerToolbar>
			<Toolbar id="_IDGenToolbar1">
				<Title id="idTitleOrden" level="H3" text="{i18n>LabelOrden}" />
				<ToolbarSpacer id="_IDGenToolbarSpacer1"/>
			</Toolbar>
		</headerToolbar>
		<columns>
			<Column id="_IDGenColumn">
				<Text id="_IDGenText1" text="{i18n>labelPos}"/>
			</Column>
			<Column id="_IDGenColumn1">
				<Text id="_IDGenText2" text="{i18n>labelMaterial}"/>
			</Column>
			<Column id="_IDGenColumn2">
				<Text id="_IDGenText3" text="{i18n>labelCantidad}"/>
			</Column>
		</columns>
		<items >
			<ColumnListItem id="_IDGenColumnListItem" type="Active">
				<cells>
					<Text id="_IDGenText4" text="{Posicion}" />
					<ObjectIdentifier id="_IDGenObjectIdentifier" title="{Material}" text="{Descripcion}"/>
					<Text id="_IDGenText5" text="{CantidadM2}" />
				</cells>
			</ColumnListItem>
		</items>
	</Table>


    </Page>
    
</mvc:View>