<mvc:View controllerName="cerro.dsi.controller.CbaMovUbic"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	xmlns:ndc="sap.ndc"
    xmlns="sap.m">
    <Page id="CbaMovUbic" title="{i18n>Cordoba} - {i18n>Entrante} - {i18n>Verificar}" titleAlignment="Center" showNavButton="true" navButtonPress="onNavBack" >
        <VBox id="_IDGenVBox">
        <f:SimpleForm id="SimpleFormDisplay354"
			editable="false"
			layout="ResponsiveGridLayout"
			title="{i18n>DatosIng}"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
                    <Label id="textPallet" text="{i18n>Pallet}: " />
                    <Text id="CbaMovUbiText01"/>
            </f:content>
		</f:SimpleForm>
        
        <f:SimpleForm id="_IDGenSimpleForm"
			editable="false"
			layout="ResponsiveGridLayout"
			title="{i18n>Ubicacion}"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content> 
                    <Label id="_IDGenLabel"  text="{i18n>Ubicacion}" />
                    <Input id="cbaMovUbic"  submit="OnAcceptEnt" />
					 <ndc:BarcodeScannerButton
			            id="barCodeVerif"
			            scanSuccess="onScanSuccess"
			            scanFail="onScanError"
			            inputLiveUpdate="onScanLiveupdate"
			            dialogTitle="Barcode Scanner"
		            />
            </f:content>
		</f:SimpleForm>        

        </VBox>

		<footer  >
            <OverflowToolbar id="_IDGenOverflowToolbarUbic" >
                <ToolbarSpacer id="_IDGenToolbarSpacerUbic"/>
                <Button id="btnAcceptUbic" text="Aceptar" press="OnAcceptEnt" type="Accept" />
                <!-- <Button id="btnCancelDest" text="Cancelar" press="OnCancelEnt" type="Reject" /> -->
            </OverflowToolbar>
        </footer> 


    </Page>
    
</mvc:View>